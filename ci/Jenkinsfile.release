pipeline {
    agent any
    // Production schedule: 2 AM on the 25th of every month, per the spec.
    triggers { cron('0 2 25 * *') }
    environment { IMAGE = "hakimburhan/analytics-website" }
    stages {
        stage('Checkout') { steps { checkout scm } }
        stage('Deploy to Kubernetes') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'dockerhub',
                                                  usernameVariable: 'DH_USER',
                                                  passwordVariable: 'DH_PASS'),
                                 file(credentialsId: 'kubeconfig', variable: 'KUBECONFIG')]) {
                    sh '''
                        echo "$DH_PASS" | docker login -u "$DH_USER" --password-stdin
                        docker pull $IMAGE:latest-build
                        docker tag $IMAGE:latest-build $IMAGE:latest
                        docker push $IMAGE:latest
                        kubectl apply -f k8s/deployment.yaml
                        kubectl apply -f k8s/service.yaml
                        kubectl rollout restart deployment/analytics-website
                        kubectl rollout status deployment/analytics-website --timeout=180s
                    '''
                }
            }
        }
    }
}
